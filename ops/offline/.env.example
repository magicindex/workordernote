# 离线安装包的默认配置示例。
# install.sh 会在安装目录生成 .env（同名文件），内容以命令行参数为准。
# 安装完成后要改端口/目录：改 .env 再跑一次 install.sh 即可，数据不会丢。
#
IMAGE=workordernote:0.3.0
CONTAINER_NAME=workordernote
PORT=8906
# 数据目录（数据库/日志/上传）；保持固定，升级时不要改。
DATA_DIR=/vol1/1000/Docker/workordernote
# 容器以这个 uid:gid 运行，必须能写 DATA_DIR（install.sh 会按当前用户自动填）。
PUID=1000
PGID=1000
TZ=Asia/Shanghai
